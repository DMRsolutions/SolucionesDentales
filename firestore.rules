rules_version = '2';

// Reglas de seguridad de Firestore para DMR Consultorio Dental.
// Cada documento clínico (pacientes, citas, pagos, planes de tratamiento) tiene
// un campo "ownerId" con el uid del doctor que lo creó. Estas reglas obligan a
// que solo ese doctor pueda leer/escribir sus propios datos.
//
// Colecciones nuevas para las funciones de negocio:
//  - doctors/{uid}      → perfil de cada doctor: nombre, usuario, WhatsApp y
//                         "plan" contratado (basico / pro / premium). El propio
//                         doctor puede editar su perfil, pero NO su "plan":
//                         solo una cuenta admin puede cambiarlo (panel de
//                         Administración).
//  - usernames/{user}   → mapa público de "nombre de usuario" → correo, para
//                         poder iniciar sesión con usuario en vez de correo.
//                         Es de lectura pública (se consulta antes de iniciar
//                         sesión) pero solo su dueño puede crearlo/editarlo.
//  - admins/{uid}       → marca qué cuentas son "dueño del sistema". Estos
//                         documentos se crean A MANO desde Firebase Console
//                         (Firestore → colección "admins" → documento con ID
//                         igual al uid del administrador); la app nunca escribe
//                         aquí, por seguridad.
//  - treatmentPlans/{id} → planes de tratamiento / presupuestos por paciente.
//  - prescriptions/{id}  → recetas por paciente, con folio consecutivo (campo
//                         "number") asignado por doctor vía doctors/{uid}.recetaCounter.
//
// Notificaciones push (citas de hoy / mañana), ver README:
//  - doctors/{uid}.fcmTokens      → tokens de notificación de los dispositivos
//                                   del doctor (el propio doctor los agrega al
//                                   activar notificaciones desde Ajustes).
//  - doctors/{uid}.notifySettings → horario de los avisos (día antes / mismo
//                                   día), configurado SOLO por un admin desde
//                                   Administración.
//  - doctors/{uid}.lastNotified   → control interno (última fecha en que se
//                                   envió cada aviso) usado por la función
//                                   programada en el servidor; el cliente
//                                   nunca lo lee ni lo escribe.
//  - doctors/{uid}.disabled       → true si un admin suspendió el acceso de
//                                   ese doctor desde Administración. Bloquea
//                                   lectura/escritura de TODOS sus datos
//                                   clínicos (ver estaSuspendido() abajo) y la
//                                   app cierra su sesión sola en cuanto lo ve.
//
// Cómo instalarlas:
//  1. Firebase Console → tu proyecto → Firestore Database → pestaña "Rules".
//  2. Pega todo el contenido de este archivo, reemplazando lo que haya.
//  3. Presiona "Publish".

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Un admin puede suspender el acceso de un doctor desde el panel de
    // Administración (doctors/{uid}.disabled = true). Esto se revisa aquí,
    // del lado del servidor, además de que la app cierra su sesión sola en
    // cuanto lo detecta — así un doctor suspendido no puede seguir leyendo ni
    // escribiendo datos aunque conserve un token de sesión válido.
    function estaSuspendido() {
      return exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
        && get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.get('disabled', false) == true;
    }

    match /patients/{patientId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid && !estaSuspendido();
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid && !estaSuspendido();
    }

    // appointments/{id}.confirmToken — token único (generado al crear la cita)
    // usado por el enlace de "Confirmar/Reagendar" que se manda por WhatsApp.
    // Ese enlace abre "confirmar.html" (página pública, sin cuenta de doctor):
    // inicia sesión anónima (Authentication → Sign-in method → Anonymous, debe
    // estar activado) y con eso puede LEER la cita por su ID (que es un texto
    // al azar de Firestore, imposible de adivinar — así funcionan los enlaces
    // "para quien tenga el link") y actualizar EXCLUSIVAMENTE su campo
    // "status" a "confirmada" o "reagendar_solicitado", nunca otro valor ni
    // otro campo. No hay Cloud Function ni plan Blaze de por medio.
    match /appointments/{appointmentId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid && !estaSuspendido();
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid && !estaSuspendido();

      // Acceso público y muy limitado del PACIENTE (enlace de WhatsApp),
      // vía inicio de sesión anónimo — ver README, sección 5.3.
      allow get: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && resource.data.status != 'cancelada'
        && request.resource.data.status in ['confirmada', 'reagendar_solicitado']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'confirmedAt', 'confirmedVia', 'rescheduleRequestedAt']);
    }

    match /payments/{paymentId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid && !estaSuspendido();
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid && !estaSuspendido();
    }

    match /treatmentPlans/{planId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid && !estaSuspendido();
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid && !estaSuspendido();
    }

    // Recetas: mismo patrón que treatmentPlans (dueño = ownerId). El número de
    // folio se asigna en el cliente dentro de una transacción que también
    // incrementa doctors/{uid}.recetaCounter (ver "update" de doctors abajo).
    match /prescriptions/{prescriptionId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid && !estaSuspendido();
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid && !estaSuspendido();
    }

    // Perfil del doctor: el dueño de la cuenta puede leer/crear/editar el suyo,
    // pero NO puede cambiar su propio "plan" ni su "notifySettings" (horario de
    // recordatorios push): eso solo lo puede cambiar un admin, desde el panel
    // de Administración. El doctor SÍ puede editar "fcmTokens" (los tokens de
    // notificación de sus propios dispositivos) al activar notificaciones desde
    // Ajustes. Un admin puede leer y editar cualquier perfil.
    match /doctors/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.plan == 'basico';
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid
          && resource.data.get('disabled', false) != true
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.disabled == resource.data.get('disabled', false)
          && request.resource.data.notifySettings == resource.data.get('notifySettings', null))
      );
    }

    // Mapa usuario → correo, necesario para iniciar sesión con usuario.
    // Lectura pública (se consulta sin haber iniciado sesión todavía); solo el
    // dueño del uid asociado puede crear/editar/borrar su propio registro.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Solo lectura del propio documento admin (para saber si soy admin).
    // La app nunca crea/edita esta colección: se administra a mano en Firebase
    // Console para máxima seguridad.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Cualquier otra colección: bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
