rules_version = '2';

// Reglas de seguridad de Firestore para DMR Consultorio Dental.
// Cada documento clínico (pacientes, citas, pagos, planes de tratamiento) tiene
// un campo "ownerId" con el uid del doctor que lo creó. Estas reglas obligan a
// que solo ese doctor pueda leer/escribir sus propios datos.
//
// Colecciones nuevas para las funciones de negocio:
//  - doctors/{uid}      → perfil de cada doctor: nombre, usuario, WhatsApp y
//                         "plan" contratado (basico / pro / premium). El propio
//                         doctor puede editar su perfil, pero NO su "plan":
//                         solo una cuenta admin puede cambiarlo (panel de
//                         Administración).
//  - usernames/{user}   → mapa público de "nombre de usuario" → correo, para
//                         poder iniciar sesión con usuario en vez de correo.
//                         Es de lectura pública (se consulta antes de iniciar
//                         sesión) pero solo su dueño puede crearlo/editarlo.
//  - admins/{uid}       → marca qué cuentas son "dueño del sistema". Estos
//                         documentos se crean A MANO desde Firebase Console
//                         (Firestore → colección "admins" → documento con ID
//                         igual al uid del administrador); la app nunca escribe
//                         aquí, por seguridad.
//  - treatmentPlans/{id} → planes de tratamiento / presupuestos por paciente.
//  - prescriptions/{id}  → recetas por paciente, con folio consecutivo (campo
//                         "number") asignado por doctor vía doctors/{uid}.recetaCounter.
//
// Cómo instalarlas:
//  1. Firebase Console → tu proyecto → Firestore Database → pestaña "Rules".
//  2. Pega todo el contenido de este archivo, reemplazando lo que haya.
//  3. Presiona "Publish".

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /patients/{patientId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /appointments/{appointmentId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /payments/{paymentId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /treatmentPlans/{planId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
    }

    // Recetas: mismo patrón que treatmentPlans (dueño = ownerId). El número de
    // folio se asigna en el cliente dentro de una transacción que también
    // incrementa doctors/{uid}.recetaCounter (ver "update" de doctors abajo).
    match /prescriptions/{prescriptionId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
    }

    // Perfil del doctor: el dueño de la cuenta puede leer/crear/editar el suyo,
    // pero NO puede cambiar su propio "plan" (solo un admin puede). Un admin
    // puede leer y editar cualquier perfil (para el panel de Administración).
    match /doctors/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.plan == 'basico';
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.plan == resource.data.plan)
      );
    }

    // Mapa usuario → correo, necesario para iniciar sesión con usuario.
    // Lectura pública (se consulta sin haber iniciado sesión todavía); solo el
    // dueño del uid asociado puede crear/editar/borrar su propio registro.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Solo lectura del propio documento admin (para saber si soy admin).
    // La app nunca crea/edita esta colección: se administra a mano en Firebase
    // Console para máxima seguridad.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Cualquier otra colección: bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
